[Unit]
Description=MULTITF Composite Signal Search (bounded-memory compose)
After=local-fs.target network-online.target
Wants=network-online.target
RequiresMountsFor=/var/tmp/traiding_pilot_ui_workspace /var/tmp/traiding_pilot_ui_workspace/artifacts/MULTITF-COMPOSITE-SIGNAL-SEARCH-1 /var/tmp/traiding_pilot_market_cache

[Service]
Type=simple
User=sergey
Group=sergey
WorkingDirectory=/var/tmp/traiding_pilot_ui_workspace/phase3_staging
Environment=ATOMIC_REPLAY_WORKERS=1
Environment=MEMORY_GUARD_THRESHOLD_GB=9
Environment=RSS_WARNING_GB=9
Environment=COMPOSITE_SEARCH_PHASE=compose-bounded
# Shared host containment — do not starve other workloads.
MemoryHigh=10G
MemoryMax=12G
# Boot/reboot may start the service; application crash/OOM must not auto-restart.
Restart=no
ExecStart=/usr/local/bin/multitf-composite-search-run.sh
# Allow finishing one in-flight candidate + durable checkpoint on shutdown/reboot.
TimeoutStopSec=300
KillMode=mixed
KillSignal=SIGTERM
SendSIGKILL=yes

[Install]
WantedBy=multi-user.target
